+int sem_down(int* sem, int timeout) {
+    uint64_t started = CIDER_TRACE_BEGIN();
+    int64_t deadline = -1;
+    if (timeout >= 0) {
+        int64_t now = workq_now_ns();
+        if (now < 0) { CIDER_TRACE_END("workqueue_wait_timeout", started, timeout); return 0; }
+        deadline = now + (int64_t)timeout * 1000000000LL;
+    }
+    for (;;) {
+        int value = __atomic_load_n(sem, __ATOMIC_ACQUIRE);
+        while (value > 0) {
+            if (__atomic_compare_exchange_n(sem, &value, value - 1, 0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) { CIDER_TRACE_END("workqueue_wait", started, timeout); return 1; }
+        }
+        struct timespec remaining, *wait = NULL;
+        if (deadline >= 0) {
+            int64_t now = workq_now_ns();
+            if (now < 0 || now >= deadline) { CIDER_TRACE_END("workqueue_wait_timeout", started, timeout); return 0; }
+            int64_t ns = deadline - now;
+            remaining.tv_sec = ns / 1000000000LL;
+            remaining.tv_nsec = ns % 1000000000LL;
+            wait = &remaining;
+        }
+        long result = LINUX_SYSCALL(__NR_futex, sem, FUTEX_WAIT | FUTEX_PRIVATE_FLAG, 0, wait, NULL, 0);
+        /* A signal, changed value, or spurious wake does not consume a token. */
+        if (result < 0 && result != -4 /* EINTR */ && result != -11 /* EAGAIN */) { CIDER_TRACE_END("workqueue_wait_timeout", started, timeout); return 0; }
+    }
+}
+void sem_up(int* sem) {
+    __atomic_fetch_add(sem, 1, __ATOMIC_RELEASE);
+    LINUX_SYSCALL(__NR_futex, sem, FUTEX_WAKE | FUTEX_PRIVATE_FLAG, 1, NULL, NULL, 0);
