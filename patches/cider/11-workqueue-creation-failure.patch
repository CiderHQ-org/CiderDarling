+/* Completion belongs to the worker handling that event, never a global singleton. */
+static struct wq_kevent_data* workq_events;
+static void workq_lock(void) {
+    while (__atomic_exchange_n(&workq_parked_lock, 1, __ATOMIC_ACQUIRE))
+        LINUX_SYSCALL(__NR_futex, &workq_parked_lock, FUTEX_WAIT | FUTEX_PRIVATE_FLAG, 1, NULL, NULL, 0);
+}
+static void workq_unlock(void) {
+    __atomic_store_n(&workq_parked_lock, 0, __ATOMIC_RELEASE);
+    LINUX_SYSCALL(__NR_futex, &workq_parked_lock, FUTEX_WAKE | FUTEX_PRIVATE_FLAG, 1, NULL, NULL, 0);
+}
+void cider_workq_bind_event(struct wq_kevent_data* event, int thread_port) {
+    if (!event) return;
+    workq_lock();
+    event->owner = thread_port;
+    event->next = workq_events;
+    workq_events = event;
+    workq_unlock();
+}
+static struct wq_kevent_data* workq_take_event(int thread_port) {
+    workq_lock();
+    struct wq_kevent_data** position = &workq_events;
+    while (*position && (*position)->owner != thread_port) position = &(*position)->next;
+    struct wq_kevent_data* event = *position;
+    if (event) *position = event->next;
+    workq_unlock();
+    return event;
+}
+
+static int workq_complete_event(int owner, const struct kevent_qos_s* events, int count) {
+    struct wq_kevent_data* event = workq_take_event(owner);
+    if (!event) return -EINVAL;
+    if (count < 0 || count > event->capacity || (count && !events)) event->nevents = -EINVAL;
+    else {
+        if (count) memmove(event->events, events, (size_t)count * sizeof(*events));
+        event->nevents = count;
+    }
+    /* The caller owns this stack object; never touch it after releasing it. */
+    sem_up(&event->sem);
+    return 0;
+}
 
