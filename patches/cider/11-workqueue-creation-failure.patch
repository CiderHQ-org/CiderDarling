+        LINUX_SYSCALL(__NR_futex, &workq_capacity_seq, FUTEX_WAKE | FUTEX_PRIVATE_FLAG, 0x7fffffff, NULL, NULL, 0);
+    }
+}
+
+static void workq_wait_for_slot(void) {
+    int seq = __atomic_load_n(&workq_capacity_seq, __ATOMIC_ACQUIRE);
+    struct timespec timeout = { 0, 100 * 1000 * 1000 };
+    workq_capacity_waiters++;
+    workq_unlock();
+    LINUX_SYSCALL(__NR_futex, &workq_capacity_seq, FUTEX_WAIT | FUTEX_PRIVATE_FLAG, seq, &timeout, NULL, 0);
+    workq_lock();
+    workq_capacity_waiters--;
+}
