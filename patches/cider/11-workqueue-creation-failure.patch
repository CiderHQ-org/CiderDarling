+/* Thread requests that found no worker slot. libdispatch counts a request as
+ * pending until a worker starts for that root queue and never retries one
+ * that failed, so a refused request would starve its queue for good. They are
+ * queued here instead and handed to the next worker that returns. Requests
+ * with the same flags are interchangeable, so only a count is kept. All of
+ * this is protected by workq_lock. */
+#define WQ_DEFERRED_SLOTS 32
+static struct { int flags, count; } workq_deferred[WQ_DEFERRED_SLOTS];
+
+static int workq_defer(int flags, int count) {
+    int free_slot = -1;
+    for (int i = 0; i < WQ_DEFERRED_SLOTS; i++) {
+        if (workq_deferred[i].count && workq_deferred[i].flags == flags) {
+            workq_deferred[i].count += count;
+            return 1;
+        }
+        if (!workq_deferred[i].count && free_slot < 0) free_slot = i;
+    }
+    if (free_slot < 0) return 0;
+    workq_deferred[free_slot].flags = flags;
+    workq_deferred[free_slot].count = count;
+    return 1;
+}
+
+/* The most urgent deferred request (highest QoS), if any. */
+static int workq_take_deferred(int* flags) {
+    int best = -1;
+    for (int i = 0; i < WQ_DEFERRED_SLOTS; i++) {
+        if (!workq_deferred[i].count) continue;
+        if (best < 0 || (workq_deferred[i].flags & WQ_FLAG_THREAD_PRIO_MASK) >
+                (workq_deferred[best].flags & WQ_FLAG_THREAD_PRIO_MASK))
+            best = i;
+    }
+    if (best < 0) return 0;
+    *flags = workq_deferred[best].flags;
+    workq_deferred[best].count--;
+    return 1;
+}
+
+/* Requests that cannot be deferred (kevent deliveries, a full table) wait for
+ * a slot instead, as upstream did for every request. */
+static void workq_release_slot(void) {
+    workq_running--;
+    if (workq_capacity_waiters) {
