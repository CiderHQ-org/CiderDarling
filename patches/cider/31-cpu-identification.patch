+    static const char *const ecx_names[32] = {
+        "SSE3","PCLMULQDQ","DTES64","MON","DSCPL","VMX","SMX","EST","TM2",
+        "SSSE3","CID",0,"FMA","CX16","XTPR","PDCM",0,"PCID","DCA","SSE4.1",
+        "SSE4.2","X2APIC","MOVBE","POPCNT","TSCDEADLINE","AES","XSAVE",
