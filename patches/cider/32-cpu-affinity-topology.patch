+static int cider_cached_count(const uint64_t* cache, uint64_t key) {
+    uint64_t entry = __atomic_load_n(cache, __ATOMIC_ACQUIRE);
+    return (entry & ~0xffffULL) == key ? (int)(entry & 0xffff) : 0;
