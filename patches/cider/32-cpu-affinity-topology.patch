+/* Linux returns the mask size, so count only bytes actually supplied. */
+static int cider_affinity(unsigned long mask[128]) {
+    __builtin_memset(mask, 0, 128 * sizeof(*mask));
+    long bytes = LINUX_SYSCALL(__NR_sched_getaffinity, 0, 128 * sizeof(*mask), mask);
+    if (bytes <= 0 || bytes > 128 * sizeof(*mask)) return 0;
+    int count = 0;
+    for (size_t i = 0; i < (size_t)bytes / sizeof(*mask); i++) count += __builtin_popcountl(mask[i]);
+    return count;
+}
+static int cider_read_host_file(const char* path, char* output, int size) {
+    long fd = LINUX_SYSCALL(__NR_openat, -100 /* AT_FDCWD */, path, 0 /* O_RDONLY */, 0);
+    if (fd < 0) return 0;
+    long length = LINUX_SYSCALL(__NR_read, fd, output, size - 1);
+    LINUX_SYSCALL(__NR_close, fd);
+    if (length < 0) return 0;
+    output[length] = 0; return 1;
+}
+static uint64_t cider_decimal(const char* value) {
+    uint64_t number = 0;
+    while (*value >= '0' && *value <= '9') {
+        if (number > UINT64_MAX / 10 - 9) return UINT64_MAX;
+        number = number * 10 + *value++ - '0';
+    }
+    return number;
+}
+static int cider_quota_cpus(int allowed) {
