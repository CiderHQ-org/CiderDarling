+                }
+                break;
+            }
+            while (*line && *line != '\n') line++;
+            if (*line) line++;
+        }
+    }
+    for (;;) {
+        __simple_sprintf(file, "%s/cpu.max", directory);
+        if (cider_read_host_file(file, maximum, sizeof(maximum)) && maximum[0] >= '0' && maximum[0] <= '9') {
+            const char* period = maximum; while (*period && *period != ' ') period++;
+            if (*period) {
