+static int cider_affinity(unsigned long mask[128]) {
+    __builtin_memset(mask, 0, 128 * sizeof(*mask));
+    long bytes = LINUX_SYSCALL(__NR_sched_getaffinity, 0, 128 * sizeof(*mask), mask);
