+ * and topology files, and the handlers may run on small stacks. A cache entry
+ * packs the mask's hash with the count so it is read in one atomic load. */
+static uint64_t cider_mask_key(const unsigned long mask[128]) {
+    uint64_t key = 1469598103934665603ULL;
